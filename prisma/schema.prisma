datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  user
  admin
  editor
  rep
}

enum BlogStatus {
  published
  draft
  scheduled
}

enum EventStatus {
  upcoming
  draft
  completed
  cancelled
  happening
}

enum DonationStatus {
  completed
  pending
  failed
  refunded
}

enum TeamMemberStatus {
  active
  inactive
  suspended
}

enum MessageStatus {
  unread
  read
}

enum MediaType {
  photo
  video
}

enum CommentStatus {
  approved
  rejected
  pending
}

model User {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String   @unique
  emailVerified DateTime?
  password String?
  name String
  phone String?
  location String?
  bio String?
  image String @default("https://res.cloudinary.com/dc8r0pdlw/image/upload/v1755290946/user_c7pd0a.png")
  role Role @default(user)
  joinDate DateTime @default(now())
  lastLogin DateTime?
  
  // Notification preferences
  emailNotifications Boolean @default(true)
  weeklyReports Boolean @default(false)
  eventReminders Boolean @default(true)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relations
  blogs Blog[]
  createdEvents Event[]
  donations Donation[]
  messages Message[]
  media Media[]
  accounts      Account[]
  addedTeamMembers TeamMember[]
  addedVolunteers Volunteer[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

 // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Blog {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String     @unique
  slug        String     @unique
  excerpt     String     @default("")
  content     String     @default("")     
  bannerImage String     @default("") 
  caption     String?
  status      BlogStatus @default(draft)
  featured    Boolean    @default(false)
  tags        String[]
  views       Int        @default(0)
  createdBy   String     @db.ObjectId // In most cases, it's the same as authorId
  
  // Relations
  authorId    String?     @db.ObjectId
  author      User?       @relation(fields: [authorId], references: [id])
  comments    BlogComment[]


  
  // Timestamps
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?

  @@unique([title, slug])
}

model Event {
  id                   String      @id @default(auto()) @map("_id") @db.ObjectId
  name                 String      @unique
  slug                 String      @unique
  detail               String      @default("")    
  excerpt              String      @default("")    
  date                 DateTime
  startTime            String
  endTime              String      @default("") 
  location             String
  maxAttendees         Int?
  currentAttendees     Int         @default(0)
  bannerImage          String      @default("") 
  caption              String?
  organizer            String      @default("") 
  status               EventStatus @default(draft)
  featured             Boolean     @default(false)
  tags                 String[]
  ticketPrice          String?     @default("") 
  registrationRequired Boolean     @default(false)
  
  // Relations
  createdBy            String      @db.ObjectId
  createdByUser        User?       @relation(fields: [createdBy], references: [id])
  comments             EventComment[]


  
  // Timestamps
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model Donation {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  donor             String?
  email             String?
  phone             String?
  amount            Float
  method            String
  campaign          String
  notes             String?
  recurring         Boolean        @default(false)
  anonymous         Boolean        @default(false)
  sendReceipt       Boolean        @default(true)
  sendThankYou      Boolean        @default(true)
  status            DonationStatus @default(completed)
  
  // Relations
  donorId           String?        @db.ObjectId
  donorUser         User?          @relation(fields: [donorId], references: [id])
  
  // Timestamps
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model TeamMember {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  role         String
  email        String
  phone        String?
  bio          String?
  status       TeamMemberStatus  @default(active)
  avatar       String?
  joinDate     DateTime
  department   String?
  location     String?
  skills       String[]

    // Relations
  addedBy      String     @db.ObjectId
  addedByUser  User?        @relation(fields: [addedBy], references: [id])

  
  // Social links
  linkedin     String?
  twitter      String?
  github       String?
  
  // Timestamps
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([name, role])
}

model Volunteer {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  volunteerType String
  avatar        String?
  featured      Boolean  @default(false)

  // Relations
  addedBy      String   @db.ObjectId
  addedByUser  User?    @relation(fields: [addedBy], references: [id])

  // Social contacts
  facebook     String?
  x            String?
  instagram    String?
  youtube      String?
  linkedin     String?
  tiktok       String?
  threads      String?
  whatsapp     String?
  telegram     String?
  snapchat     String?
  pinterest    String?
  medium       String?

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name, volunteerType])
}

model Message {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  sender    String
  email     String
  subject   String
  content   String
  status    MessageStatus @default(unread)
  avatar    String?
  
  // Relations
  senderId  String?       @db.ObjectId
  senderUser User?        @relation(fields: [senderId], references: [id])
  
  // Timestamps
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Media {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  type        MediaType
  src         String
  srcKey      String
  alt         String?
  poster      String?
  posterKey   String?
  title       String?
  caption     String?
  description String?
  createdBy   String    @db.ObjectId

  createdByUser User?   @relation(fields: [createdBy], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}



model BlogComment {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  comment         String
  authorName      String
  authorEmail     String
  blog            Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)
  blogId          String @db.ObjectId
  status          CommentStatus @default(pending)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventComment {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  comment         String
  authorName      String
  authorEmail     String
  event            Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId          String @db.ObjectId
  status          CommentStatus @default(pending)
  
  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppActivity {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  title         String      // e.g., "New blog post published"
  description   String      // e.g., "Community Outreach Program Success"
  time          DateTime    @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model FoundationInfo {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  email       String
  description String?
  address     String?
  phone       String?
  facebook    String?
  x           String?
  instagram   String?
  youtube     String?
  linkedin    String?
  tiktok      String?
  threads     String?
  whatsapp    String?
  telegram    String?
  snapchat    String?
  pinterest   String?
  medium      String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AboutPage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  aboutUs   String   @default("")
  vision    String   @default("")
  mission   String   @default("")
  hero      AboutHeroSection?
  story     AboutStorySection?
  team      AboutTeamSection?
  foundersMessage AboutFoundersMessageSection?
  cta       AboutCtaSection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  role      String?
  quote     String
  avatar    String?
  order     Int      @default(0)
  published Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingPageData {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  hero        HeroSection?
  about       AboutSection?
  values      ValuesSection?
  volunteers  VolunteersSection?
  impact      ImpactSection?
  testimonials TestimonialsSection?
  featuredBlogs FeaturedContentSection?
  featuredEvents FeaturedContentSection?
  faqs        FaqSection?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

type SectionIntro {
  eyebrow     String
  heading     String
  description String
}

type HeroSection {
  title    String
  subtitle String
  image    String?
  ctas     CtaButton[]
}

type AboutSection {
  intro      SectionIntro
  themePhoto String?
  cards      SectionCardItem[]
  ctas       CtaButton[]
}

type ValuesSection {
  intro       SectionIntro
  cards       SectionCardItem[]
  closingText String?
  ctas        CtaButton[]
}

type VolunteersSection {
  intro      SectionIntro
  ctaHeading String?
  ctas       CtaButton[]
}

type ImpactSection {
  intro      SectionIntro
  youtubeUrl String?
  stats      LandingStatItem[]
  ctas       CtaButton[]
}

type TestimonialsSection {
  intro SectionIntro
  limit Int
  ctas  CtaButton[]
}

type FeaturedContentSection {
  intro SectionIntro
  limit Int
  ctas  CtaButton[]
}

type FaqSection {
  intro SectionIntro
  items FaqItem[]
  ctas  CtaButton[]
}

type CtaButton {
  id        String
  label     String
  href      String
  variant   String
  order     Int
  published Boolean
}

type SectionCardItem {
  id          String
  subject     String
  kicker      String?
  description String
  order       Int
  published   Boolean
}

type LandingStatItem {
  id        String
  value     String
  title     String
  order     Int
  published Boolean
}

type FaqItem {
  id        String
  question  String
  answer    String
  order     Int
  published Boolean
}

type AboutHeroSection {
  intro        SectionIntro
  image        String?
  mission      String
  vision       String
  calloutTitle String?
  calloutText  String?
  heroBackgroundColor  String?
  calloutBackgroundColor  String?
}

type AboutStorySection {
  intro        SectionIntro
  body         String
  image        String?
  captionTitle String?
  captionText  String?
  trustPoints  String[]
}

type AboutTeamSection {
  intro SectionIntro
}

type AboutFoundersMessageSection {
  intro      SectionIntro
  quote      String
  body       String
  image      String?
  ctas       CtaButton[]
}

type AboutCtaSection {
  intro           SectionIntro
  backgroundImage String?
  ctas            CtaButton[]
}

model WebsiteSettings {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  maintenanceMode     Boolean  @default(false)
  blogComments        Boolean  @default(true)
  eventComments       Boolean  @default(true)
  eventRegistration   Boolean  @default(false)
  
  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ResetPasswordToken {
  id      String   @id @default(auto()) @map("_id") @db.ObjectId
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}
